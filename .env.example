# admin-fe 환경 변수 예시
#
# 이 파일을 .env 로 복사한 뒤 각 항목을 채웁니다.
#   cp .env.example .env
#
# 실제 값은 인프라 담당자에게 받으세요. .env 는 커밋되지 않습니다.
#
# ⚠️ VITE_ 로 시작하는 값은 빌드할 때 번들에 그대로 인라인되어
#    브라우저에서 누구나 볼 수 있습니다. 비밀로 지켜야 하는 값을 넣지 마세요.

# 공개 API 주소
VITE_API_BASE_URL=

# 인증 API 주소 (비워 두면 VITE_API_BASE_URL 로 폴백)
VITE_APP_API_URL=

# 로컬 백엔드 주소
VITE_API_LOCAL_URL=
